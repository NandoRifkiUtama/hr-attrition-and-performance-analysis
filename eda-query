Attrition,
ROUND(AVG(JobSatisfaction),2) AS jobSatisfaction,
ROUND(AVG(EnvironmentSatisfaction),2) AS EnvironmentSatisfaction,
ROUND(AVG(RelationshipSatisfaction),2) AS RelationshipSatisfaction,
